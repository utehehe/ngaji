{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ngaji",
  "version": "1.0.0",
  "identifier": "id.ngaji.app",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../kitab": "kitab"
    },
    "fileAssociations": [
      {
        "ext": ["ngaji", "safinah"],
        "name": "File Kitab Ngaji",
        "description": "File proyek kitab Ngaji",
        "role": "Editor"
      }
    ]
  }
}
